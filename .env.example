# =====================================================================
# 金枢 (Jin-Shu OS) - 环境与大模型配置模板 (Phase 1 推理模型增强版)
# =====================================================================

# 1. 大模型推理接口配置 (OpenAI 兼容协议)
# 选项 A: 本地 vLLM 推理服务 (推荐 2x H100 运行 QwQ-32B 或 DeepSeek-R1-Distill-Qwen-32B)
OPENAI_API_KEY=none
OPENAI_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/QwQ-32B

# 选项 B: DeepSeek 官方 API (原生支持深度思考 deepseek-reasoner)
# OPENAI_API_KEY=sk-your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-reasoner

# 选项 C: Apple Silicon Mac (MLX 本地推理，M 系列芯片统一内存)
# OPENAI_API_KEY=mlx-local
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=mlx-community/QwQ-32B-4bit

# 2. Web 服务端口
PORT=8000

# 3. 动环与监控服务接入模式 (MOCK: 内置仿真快照 / EXTERNAL_API: 真实生产对接)
MONITOR_MODE=MOCK
MONITOR_API_URL=http://internal-cmdb/v1/alerts
MONITOR_API_TOKEN=your_auth_token_here

# 4. OpenStack 云平台集成配置
OPENSTACK_AUTH_URL=http://10.210.24.15:5000/v3
OPENSTACK_USERNAME=admin
OPENSTACK_PASSWORD=password
OPENSTACK_PROJECT_NAME=admin
OPENSTACK_USER_DOMAIN_NAME=DEFAULT
OPENSTACK_PROJECT_DOMAIN_NAME=DEFAULT
OPENSTACK_REGION_NAME=RegionOne
